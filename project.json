{
  "name": "medibuddy-fda-search",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/.next"],
      "options": {
        "command": "next build"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next dev"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next start"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next lint"
      }
    }
  }
}
